    "size_ref: representative layer that sets the output image size and metadata",
    "min: layer or attribute setting the minimum limit when Range Values is Min/Max",
    "max: layer or attribute setting the maximum limit when Range Values is Min/Max",
    "ramp: layer or attribute sampled horizontally for range values when Range Values is Float Ramp",
    "seed: layer or attribute controlling the random value distribution"
  ],
  "key_parameters": [
    "Signature: layer type the node outputs",
    "Range Values: Min/Max, Float Ramp or Specific Values",
    "Minimum / Maximum: bounds of the random range in Min/Max mode",
    "Float Ramp: reshapes the uniformly distributed random value through a ramp",
    "Number of Values, Value, Weight, Value List: for Specific Values; Value List accepts ranges with steps, such as 0-1:0.25",
    "Random per Pixel: selection varies per pixel",
    "Seed and Time: both change the random outcome",
    "Zero Negative IDs: when a seed input is wired, outputs 0 wherever the seed is a negative integer"
  ],
  "caveats": [
