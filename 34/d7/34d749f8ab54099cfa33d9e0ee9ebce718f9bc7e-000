    "1. texture: the pattern to tile.",
    "2. position: custom position used to project texture coordinates.",
    "3. normal: layer that sets a custom basis for orienting the hex tiles.",
    "4. size: controls tile size based on UV coordinates.",
    "5. scale: controls the global scale of the tiles.",
    "6. rot: controls the global rotation of the tiles.",
    "7. contrast: controls contrast between blended cells.",
    "8. contrast_falloff: controls contrast falloff between cells.",
    "9. weightexp: controls the exponential weight of transition areas.",
    "10. blend: controls blending between triplanar projections."
  ],
  "key_parameters": [
    {"name": "Signature", "meaning": "The layer type the source accepts."},
