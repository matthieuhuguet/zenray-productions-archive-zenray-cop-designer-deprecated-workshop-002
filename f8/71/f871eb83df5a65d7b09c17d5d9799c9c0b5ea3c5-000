    "centroid_ref: point geometry marking the center of the simulation, used only when Divisions is set to Coverage"
  ],
  "key_parameters": [
    "Divisions: Voxel Size uses world units and suits fully 3D simulations; Resolution derives voxel size from a default 2-unit square imaging plane (voxel size = 2 / Resolution); Coverage sizes voxels from camera resolution and distance so invisible detail is not simulated",
    "Voxel Size: size of one voxel in world coordinates",
    "Resolution: simulation resolution when it fills the standard imaging plane",
    "Pixel Coverage: number of screen pixels covering one voxel; default 2.5",
    "Min Voxel Size: when enabled, prevents voxels from becoming smaller than a set minimum (labeled Min Vozel Size on the page)"
  ],
  "caveats": [
    "Requires DOP-level permissions; not in Houdini Core, only in Houdini FX, Apprentice, Indie and Education",
    "camera_ref and centroid_ref matter only in Coverage mode"
