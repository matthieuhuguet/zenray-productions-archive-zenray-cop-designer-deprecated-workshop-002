{
  "name": "pyro_block_begin",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/pyro_block_begin.html",
  "status": "ok",
  "summary_en": "Opens a Pyro simulation block, paired with a Pyro Block End at the same network level. Work that does not depend on earlier frames belongs before it so it cooks only once; post-processing that feeds nothing back belongs after the block end. Most volume inputs are mixed in through the Source tab on Pyro Block End.",
  "inputs": [
    "vdb_ref: VDB metadata setting the simulation voxel size",
    "density: Float VDB, smoke thickness per voxel",
    "temperature: Float VDB, per-voxel temperature",
    "v: Vector VDB, wind speed excluding Ambient Velocity",
    "flame: Float VDB of current flames",
    "divergence (optional): Float VDB goal divergence",
    "collision (optional): Float VDB signed distance field of colliders",
    "collisionv (optional): Vector VDB collider velocity",
    "feedback: cable of values fed back each iteration; structure must match the Block End input",
    "passthrough (optional): cable of layers and VDBs computed outside the simulation, read each frame",
    "bounds_geo (optional): geometry limiting the simulation domain",
    "source_points (optional): geometry for sourcing from implicit surfaces",
    "collision_points (optional): geometry for collision from implicit surfaces"
  ],
  "key_parameters": [
    "Block Path: path to the matching Pyro Block End COP; must be at the same network level"
  ],
  "caveats": [
    "Requires DOP-level permissions; not available in Houdini Core",
    "Time Shift nodes cannot be used inside a block when they need inputs at different times; use Time Pack before the block and feed frames in as a cable",
    "The feedback input is read only on the initial frame",
    "Passthrough data is read each frame but cannot depend on simulation results",
    "Newly activated voxels start at temperature 0, so that value works best as a baseline"
  ],
  "resume_fr": "Pyro Block Begin ouvre un bloc de simulation Pyro et doit être associé à un Pyro Block End au même niveau de réseau."
}
