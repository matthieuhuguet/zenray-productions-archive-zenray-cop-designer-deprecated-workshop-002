    "mono: the original mono layer to convert",
    "alpha (optional): a mono layer used as the alpha channel of the result"
  ],
  "key_parameters": [
    "Fill Alpha: how alpha is created when no alpha layer is given. Use Mono as Alpha uses the input mono layer as alpha; Constant Value sets a fixed alpha",
    "Alpha Value: the alpha applied when Fill Alpha is Constant Value"
  ],
  "caveats": [
    "No premultiplication is applied.",
    "By default the mono layer is replicated to RGB and alpha, which gives a white image with varying alpha for premultiplied layers. This can be unexpected.",
    "The alpha input is mixed without premultiplication, so the Premultiply COP may be needed."
  ],
  "resume_fr": "Convertit un calque mono en RGBA en dupliquant son canal, avec un alpha optionnel fourni par un second calque, sans prémultiplication."
