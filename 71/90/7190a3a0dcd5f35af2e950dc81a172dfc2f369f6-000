  "summary_en": "Z Composite combines two layers according to their depth, placing the closer pixel in front of the farther one. Output: the composite layer with combined depth.",
  "inputs": [
    "bg: background layer; sets the output size and resolution; if it has the lower depth it is placed over fg instead",
    "bgdepth: per-pixel depth of the background layer",
    "fg: nominal foreground layer; if it has the greater depth it is placed behind bg instead",
    "fgdepth: per-pixel depth of the foreground layer"
  ],
  "key_parameters": [
    "Signature: the layer type the source accepts",
    "Convert Depth: how input depth layers are read; Depth and Distance treat zero as infinity and increase away from the camera; Height has no special zero and increases toward the camera; the combined depth output keeps the input's type",
    "FG Offset: biases foreground depth toward the camera to prevent z-fighting when both share a depth; does not affect the output depth"
  ],
  "caveats": [
    "An ID layer cannot be blended, so the node outputs the ID value of the lowest-depth pixel instead"
  ],
  "resume_fr": "Compose deux couches selon leur profondeur, en plaçant le pixel le plus proche devant l'autre, avec gestion de la conversion de profondeur et de l'offset anti-z-fighting."
