{
  "name": "rasterizelayer",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/rasterizelayer.html",
  "status": "ok",
  "summary_en": "Rasterize Layer images a source layer as seen from the camera of another layer, producing a layer that shows the source from that viewpoint. It is the inverse of Project on Layer. Outputs are result, the source rasterized into camera_ref space, and depth, the distance from the camera to the source layer.",
  "inputs": [
    "camera_ref: supplies the camera viewpoint; its pixels are not used, only its resolution, location and viewpoint matter",
    "source: layer to image; must be Mono, UV, RGB or RGBA"
  ],
  "key_parameters": [
    "Signature: layer type the source input accepts",
    "Move to Origin: moves the output layers to canonical space",
    "Invert Transformation: inverts the computed transform used to project the source onto the camera reference",
    "Crop to Content: crops the output to the source's transformed data window",
    "Border: sampling outside the incoming layer boundaries, defaults to the layer border property",
    "Filter: sampling method, default Box"
  ],
  "caveats": [
    "Re-cropping is not possible while Invert Transformation is on.",
    "The source input accepts only Mono, UV, RGB or RGBA layers.",
    "The pixel content of camera_ref is ignored."
  ],
  "resume_fr": "Ce nœud image un calque source tel qu'il est vu depuis la caméra d'un autre calque, et fournit aussi la distance de la source."
}
