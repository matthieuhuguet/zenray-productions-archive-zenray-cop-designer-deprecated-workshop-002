    "source: the original layer to apply the vignetting to",
    "mask (optional): per-pixel mask whose amount is scaled by the Mask parameter"
  ],
  "key_parameters": [
    "Signature: sets the layer type the source accepts",
    "Mask: how much of the new value mixes with the original (default 1)",
    "Brightness: scales how bright or dim the vignette is",
    "Shape: Round (circular), Rectangle, or Blend between the two",
    "Circle Radius and Circle Scale: size of the round vignette and its non-uniform stretch",
    "Rectangle Size and Round Corners: size and corner rounding of the rectangle",
    "Blend: mixes Round and Rectangle when Shape is Blend",
    "Center: vignette centre in image space",
    "Blur: softens the edge of the vignette",
    "Shape Ramp: adjusts the shape profile of the vignette"
