{
  "name": "refractfromheight",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/refractfromheight.html",
  "status": "ok",
  "summary_en": "Refract from Height treats a height layer as the surface of a transparent medium, such as water, glass or thin ice, and treats a source layer as the ground beneath it. It bends view rays at that surface using its normals, then samples the source image where the rays reach the ground. Documented as since Houdini 22.0.",
  "inputs": [
    "source: layer sampled through the refractive surface; the only required input",
    "height: layer defining the refractive surface; if a normal input is wired, that input supplies the surface normals instead",
    "ground: optional height layer for the surface the source sits on; a flat ground plane is used if not connected",
    "normal: optional RGB normal layer in Signed or Offset format, used for the surface normals",
    "envmap: optional environment map for Fresnel-style reflection and for the refracted background behind transparent source pixels"
  ],
  "key_parameters": [
    "Index of Refraction (Height section): how much light bends at the surface; default 1.33 approximates water",
    "Height Offset / Height Scale: adjust the height before ray tracing; Height Scale is disabled when a normal input is connected",
    "Ground parameters: Index of Refraction (default 1.0, air), Ground Offset, Ground Scale and Ray Trace Iterations, which control where refracted rays meet the ground",
    "Material: Water, Glass or Diamond, each with its own dispersion and absorbance behaviour",
    "Medium Color, Light Absorbance, Dispersion, Number of Colors: tint, absorption along the path, wavelength separation, and smoothness of dispersion",
    "Reflection (Strength, Bias, Color, Saturation Scale, Environment Map Offset): reflected environment when envmap is connected",
    "View Azimuth, View Altitude, View Position, Directional, Space: view ray direction or position"
  ],
  "caveats": [
    "Connecting normal changes how the surface normals are obtained and disables Height Scale.",
    "Without envmap there is no environment reflection, and transparent source pixels do not reveal a refracted background.",
    "A higher Number of Colors gives smoother dispersion but increases cook time.",
    "The Derivative COP settings inside the node subnetwork (Compute Derivative outside Image, Kernel Size) affect the computed surface normals and the ground calculations.",
    "The page gives only a basic setup example and no guidance on advanced configurations or performance beyond these notes."
  ],
  "resume_fr": "Ce nœud traite un calque de hauteur comme la surface d'un milieu transparent et réfracte les rayons pour échantillonner le calque source placé dessous."
}
